<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/AndroidVersionWidget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:contentDescription="@string/widget_initial_content_description"
    android:focusable="true"
    android:gravity="center"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:paddingHorizontal="0dp"
    android:paddingVertical="2dp">

    <TextView
        android:id="@+id/widget_android_label"
        style="@style/AndroidVersionWidgetText.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:importantForAccessibility="no"
        android:text="@string/widget_android_label"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widget_version"
        style="@style/AndroidVersionWidgetText.Value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textSize="39sp" />

</LinearLayout>
