<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/AndroidVersionWidgetShort"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:contentDescription="@string/widget_initial_content_description"
    android:focusable="true"
    android:importantForAccessibility="yes">

    <TextView
        android:id="@+id/widget_android_label"
        style="@style/AndroidVersionWidgetShortText.Label"
        android:text="@string/widget_android_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/widget_version"
        style="@style/AndroidVersionWidgetShortText.Value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
