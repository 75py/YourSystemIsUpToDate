<!-- The sizes live in the PlayWidget styles, shared with the picker preview. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/PlayWidget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <TextView
        style="@style/PlayWidgetText.Label"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="@string/play_widget_label" />

    <TextView
        android:id="@+id/play_widget_version"
        style="@style/PlayWidgetText.Value"
        android:layout_width="match_parent"
        android:layout_height="0dp" />
</LinearLayout>
