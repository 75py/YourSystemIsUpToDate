<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/AndroidVersionWidget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:clickable="true"
    android:contentDescription="@string/widget_initial_content_description"
    android:focusable="true"
    android:gravity="center_vertical"
    android:importantForAccessibility="yes"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="7dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_android_label"
            style="@style/AndroidVersionWidgetText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_android_label"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/widget_version"
            style="@style/AndroidVersionWidgetText.Value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textSize="43sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_metadata"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="7dp"
        android:layout_weight="6"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/widget_security_patch_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="noHideDescendants">

            <TextView
                android:id="@+id/widget_security_patch_label"
                style="@style/AndroidVersionWidgetText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="@string/widget_security_patch_compact_label"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_security_patch"
                style="@style/AndroidVersionWidgetText.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@id/widget_security_patch_label"
                android:fontFamily="sans-serif-condensed"
                android:textSize="13sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/widget_build_id_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="noHideDescendants">

            <TextView
                android:id="@+id/widget_build_id_label"
                style="@style/AndroidVersionWidgetText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="@string/widget_build_id_label"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_build_id"
                style="@style/AndroidVersionWidgetText.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@id/widget_build_id_label"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/widget_api_level_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="noHideDescendants">

            <TextView
                android:id="@+id/widget_api_level_label"
                style="@style/AndroidVersionWidgetText.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="@string/widget_api_level_label"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_api_level"
                style="@style/AndroidVersionWidgetText.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@id/widget_api_level_label"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp" />

        </RelativeLayout>

    </LinearLayout>

</LinearLayout>
