<!-- Widget picker preview (Android 12+): widget_google_play_update with a sample value. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:importantForAccessibility="yes"
    android:contentDescription="@string/play_widget_description"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/play_widget_label"
        android:textColor="@color/widget_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/play_widget_preview_version"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/widget_text_primary"
        android:textSize="18sp" />
</LinearLayout>
