<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/AndroidVersionWidget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:contentDescription="@string/widget_initial_content_description"
    android:focusable="true"
    android:gravity="center"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:paddingHorizontal="2dp"
    android:paddingVertical="2dp">

    <TextView
        android:id="@+id/widget_android_label"
        style="@style/AndroidVersionWidgetText.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:importantForAccessibility="no"
        android:text="@string/widget_android_label"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_version"
        style="@style/AndroidVersionWidgetText.Value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textSize="36sp" />

    <LinearLayout
        android:id="@+id/widget_metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_security_patch_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical">

            <TextView
                style="@style/AndroidVersionWidgetText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/widget_security_patch_compact_label"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_security_patch"
                style="@style/AndroidVersionWidgetText.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_api_level_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical">

            <TextView
                style="@style/AndroidVersionWidgetText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/widget_api_level_label"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_api_level"
                style="@style/AndroidVersionWidgetText.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
