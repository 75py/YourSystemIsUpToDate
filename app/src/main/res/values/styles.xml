<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Shared by every Android version widget layout and the Android 12+ picker preview.
         Sizes, spacing and accessibility attributes differ per layout and stay in the
         layouts. -->
    <style name="AndroidVersionWidget">
        <item name="android:background">@drawable/widget_background</item>
    </style>

    <style name="AndroidVersionWidgetText">
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="AndroidVersionWidgetText.Label">
        <item name="android:textColor">@color/widget_text_secondary</item>
    </style>

    <style name="AndroidVersionWidgetText.Value">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/widget_text_primary</item>
    </style>

    <!-- The short layout and its picker preview also share their sizes. The padding is
         written per edge because aapt2 back-ports paddingHorizontal/paddingVertical below
         API 26 only when they are attributes of a layout, not items of a style. -->
    <style name="AndroidVersionWidget.Short">
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>

    <style name="AndroidVersionWidgetText.Label.Short">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="AndroidVersionWidgetText.Value.Short">
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textSize">42sp</item>
    </style>

    <!-- Shared visual attributes for widget_google_play_update and its picker preview.
         Both lines shrink to fit the update level. Keep room for values longer than the
         preview, including suffixes such as "2024-05-01 R" (12 characters). The lower
         bounds use dp so they do not grow at 200% font scale; longer arbitrary values
         can still be ellipsized in a single cell. -->
    <style name="PlayWidget" tools:targetApi="o">
        <item name="android:background">@drawable/widget_background</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:paddingVertical">2dp</item>
    </style>

    <style name="PlayWidgetText" tools:targetApi="o">
        <item name="android:importantForAccessibility">no</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">6dp</item>
        <item name="android:autoSizeStepGranularity">1dp</item>
    </style>

    <style name="PlayWidgetText.Label" tools:targetApi="o">
        <item name="android:gravity">bottom|center_horizontal</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:autoSizeMaxTextSize">14sp</item>
    </style>

    <style name="PlayWidgetText.Value" tools:targetApi="o">
        <item name="android:gravity">top|center_horizontal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/widget_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:autoSizeMaxTextSize">18sp</item>
    </style>
</resources>
